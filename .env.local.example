# ===========================================
# CKB Credential Registry - Environment
# ===========================================
# Copy this file to .env.local and fill in the values

# Network selection: 'devnet' | 'testnet' | 'mainnet'
NEXT_PUBLIC_NETWORK=devnet

# ===========================================
# Devnet (OffCKB) - Default for local development
# ===========================================
NEXT_PUBLIC_CKB_NODE_URL=http://localhost:28114
NEXT_PUBLIC_CKB_INDEXER_URL=http://localhost:28114

# ===========================================
# Testnet (uncomment when deploying to testnet)
# ===========================================
# NEXT_PUBLIC_NETWORK=testnet
# NEXT_PUBLIC_CKB_NODE_URL=https://testnet.ckb.dev
# NEXT_PUBLIC_CKB_INDEXER_URL=https://testnet.ckb.dev

# ===========================================
# Mainnet (uncomment when deploying to mainnet)
# ===========================================
# NEXT_PUBLIC_NETWORK=mainnet
# NEXT_PUBLIC_CKB_NODE_URL=https://mainnet.ckb.com
# NEXT_PUBLIC_CKB_INDEXER_URL=https://mainnet.ckb.com

# ===========================================
# Spore Script Configurations (Devnet)
# ===========================================
# These are for OffCKB devnet script addresses

# Spore DOB code hash
NEXT_PUBLIC_SPORE_CODE_HASH=0x7e8bf78a62232caa2f5d47e691e8db1a90d05e93dc6828ad3cb935c01ec6d208

# Spore Cluster code hash
NEXT_PUBLIC_SPORE_CLUSTER_CODE_HASH=0x7366a61534fa7c7e6225ecc0d828ea3b5366adec2b58206f2ee84995fe030075

# OmniLock code hash (for wallet addresses)
NEXT_PUBLIC_OMNILOCK_CODE_HASH=0x540ecae6c76b3830d105c5aa9e6239b2b9804292d4df9f9e72d018d76a14e2c

# ===========================================
# App Configuration
# ===========================================
# App name shown in wallet connect dialog
NEXT_PUBLIC_APP_NAME=CKB Credential Registry

# ===========================================
# Wallet Connect Project ID (optional)
# For WalletConnect support in production
# ===========================================
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id
